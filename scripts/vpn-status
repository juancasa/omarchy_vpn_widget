#!/usr/bin/env bash
# Omarchy bar command widget: VPN status for NetworkManager VPN profiles.
# Prints Waybar-style JSON: {"text","tooltip","class"}.
set -u

ICON_ON=$'\U000F099D'   # nf-md-shield_lock
ICON_OFF=$'\U000F099E'  # nf-md-shield_off
ICON_BUSY=$'\U000F099F' # nf-md-shield_outline

json() { printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$1" "$2" "$3"; }

mapfile -t profiles < <(nmcli -g NAME,TYPE connection show 2>/dev/null | awk -F: '$2=="vpn"||$2=="wireguard"{print $1}')
if [ ${#profiles[@]} -eq 0 ]; then
  json "$ICON_OFF" "No VPN profiles. Right-click to add one." "none"
  exit 0
fi

# Active VPN, if any. Field STATE is activating/activated for VPNs.
active=$(nmcli -g NAME,TYPE,STATE connection show --active 2>/dev/null | awk -F: '($2=="vpn"||$2=="wireguard"){print $1":"$3; exit}')
if [ -n "$active" ]; then
  name=${active%%:*}; state=${active##*:}
  if [ "$state" = "activated" ]; then
    json "$ICON_ON" "VPN connected: $name\nLeft-click to disconnect" "active"
  else
    json "$ICON_BUSY" "VPN $state: $name" "busy"
  fi
  exit 0
fi

tip="VPN off. Left-click to connect ${profiles[0]}"
[ ${#profiles[@]} -gt 1 ] && tip="VPN off. ${#profiles[@]} profiles; left-click connects ${profiles[0]}"
json "$ICON_OFF" "$tip\nRight-click to edit connections" "inactive"
