#!/usr/bin/env bash
# Toggle the NetworkManager VPN: disconnect the active one, otherwise connect
# the preferred profile.
#
#   vpn-toggle [profile-name]
#
# Profile preference, in order: the argument, then one line in
# ~/.config/omarchy/bar/vpn-default, then the first VPN profile nmcli lists.
# Set VPN_WIDGET_QUIET=1 to suppress desktop notifications.
set -u

notify() {
  [ "${VPN_WIDGET_QUIET:-0}" = 1 ] && return 0
  command -v notify-send >/dev/null && notify-send -a "VPN" "$@"
}

active=$(nmcli -g NAME,TYPE connection show --active 2>/dev/null | awk -F: '($2=="vpn"||$2=="wireguard"){print $1; exit}')
if [ -n "$active" ]; then
  if nmcli connection down "$active" >/dev/null 2>&1; then
    notify "VPN disconnected" "$active"
  else
    notify -u critical "VPN disconnect failed" "$active"
  fi
  exit 0
fi

mapfile -t profiles < <(nmcli -g NAME,TYPE connection show 2>/dev/null | awk -F: '$2=="vpn"||$2=="wireguard"{print $1}')
if [ ${#profiles[@]} -eq 0 ]; then
  notify "No VPN profiles" "Import one with: nmcli connection import type openvpn file <file.ovpn>"
  exit 1
fi

target=${profiles[0]}
want=${1:-}
default_file=~/.config/omarchy/bar/vpn-default
[ -z "$want" ] && [ -s "$default_file" ] && want=$(head -n1 "$default_file")
if [ -n "$want" ]; then
  found=0
  for p in "${profiles[@]}"; do [ "$p" = "$want" ] && { target=$p; found=1; }; done
  [ $found = 1 ] || notify -u normal "VPN profile '$want' not found" "Connecting $target instead"
fi

if out=$(nmcli connection up "$target" 2>&1); then
  notify "VPN connected" "$target"
else
  notify -u critical "VPN connect failed" "$target: ${out##*$'\n'}"
fi
