#!/usr/bin/env bash
# Control NetworkManager VPN connections.
#
#   vpn-toggle [profile]          toggle: disconnect the active VPN, else connect
#                                 the preferred profile (argument, then one line
#                                 in ~/.config/omarchy/bar/vpn-default, then the
#                                 first VPN profile nmcli lists)
#   vpn-toggle --connect <name>   connect <name>, switching from any active VPN
#   vpn-toggle --disconnect       disconnect every active VPN
#   vpn-toggle --enforce          if more than one VPN is up, keep the most
#                                 recently activated one and disconnect the rest
#
# Only one VPN is ever left active: every connect path first brings down any
# other VPN connection NetworkManager reports as active.
# Set VPN_WIDGET_QUIET=1 to suppress desktop notifications.
set -u

notify() {
  [ "${VPN_WIDGET_QUIET:-0}" = 1 ] && return 0
  command -v notify-send >/dev/null && notify-send -a "VPN" "$@"
}

# Active VPN connection names, newest activation first (TIMESTAMP is the last
# successful activation time NetworkManager recorded).
active_vpns() {
  nmcli -g NAME,TYPE,TIMESTAMP connection show --active 2>/dev/null \
    | awk -F: '($2=="vpn"||$2=="wireguard"){print $3":"$1}' | sort -t: -k1,1nr | cut -d: -f2-
}

down_all_except() {
  local keep=${1:-} name rc=0
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    [ "$name" = "$keep" ] && continue
    bring_down "$name" || rc=1
  done < <(active_vpns)
  return $rc
}

vpn_profiles() {
  nmcli -g NAME,TYPE connection show 2>/dev/null | awk -F: '$2=="vpn"||$2=="wireguard"{print $1}'
}

bring_down() {
  if nmcli connection down "$1" >/dev/null 2>&1; then
    notify "VPN disconnected" "$1"
  else
    notify -u critical "VPN disconnect failed" "$1"
    return 1
  fi
}

bring_up() {
  local out
  if out=$(nmcli connection up "$1" 2>&1); then
    notify "VPN connected" "$1"
  else
    notify -u critical "VPN connect failed" "$1: ${out##*$'\n'}"
    return 1
  fi
}

mode=toggle
want=""
case "${1:-}" in
  --connect) mode=connect; want=${2:-} ;;
  --disconnect) mode=disconnect ;;
  --enforce) mode=enforce ;;
  -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
  *) want=${1:-} ;;
esac

mapfile -t actives < <(active_vpns)
active=${actives[0]:-}

if [ "$mode" = enforce ]; then
  [ ${#actives[@]} -gt 1 ] || exit 0
  notify "Only one VPN allowed" "Keeping $active, disconnecting the rest"
  down_all_except "$active"; exit $?
fi

if [ "$mode" = disconnect ]; then
  [ -n "$active" ] || { notify "VPN already off"; exit 0; }
  down_all_except ""; exit $?
fi

if [ "$mode" = toggle ] && [ -n "$active" ]; then
  down_all_except ""; exit $?
fi

mapfile -t profiles < <(vpn_profiles)
if [ ${#profiles[@]} -eq 0 ]; then
  notify "No VPN profiles" "Import one with: nmcli connection import type openvpn file <file.ovpn>"
  exit 1
fi

target=${profiles[0]}
default_file=~/.config/omarchy/bar/vpn-default
[ -z "$want" ] && [ -s "$default_file" ] && want=$(head -n1 "$default_file")
if [ -n "$want" ]; then
  found=0
  for p in "${profiles[@]}"; do [ "$p" = "$want" ] && { target=$p; found=1; }; done
  if [ $found = 0 ]; then
    [ "$mode" = connect ] && { notify -u critical "VPN profile not found" "$want"; exit 1; }
    notify "VPN profile '$want' not found" "Connecting $target instead"
  fi
fi

# Connecting while other VPNs are up: switch, so only one stays active.
if [ ${#actives[@]} -gt 0 ]; then
  already=0
  for a in "${actives[@]}"; do [ "$a" = "$target" ] && already=1; done
  down_all_except "$target" || exit 1
  [ $already = 1 ] && { notify "VPN already connected" "$target"; exit 0; }
fi
bring_up "$target"
